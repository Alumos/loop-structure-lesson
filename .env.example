# 部署时复制为 .env。请勿提交真实密钥。
IMAGE_NAME=ghcr.io/alumos/loop-structure-lesson:latest
APP_PORT=18763
BIND_IP=0.0.0.0
CLASS_SYSTEM_URL=https://class.alumos.cn
CLASS_SYSTEM_TOKEN=replace-with-your-shared-token
TEACHER_USERNAME=Alumos
# 教师密码不需要配置或保存：登录时由 ClassOrbit 验证。
# 使用 HTTPS 域名反向代理时，填写实际来源并将后两项设为 true / 1。
PUBLIC_ORIGIN=
COOKIE_SECURE=false
TRUST_PROXY=0
REPLAY_RETENTION_DAYS=7
RECORD_RETENTION_DAYS=30
MAX_EVENTS_PER_STUDENT=20000
